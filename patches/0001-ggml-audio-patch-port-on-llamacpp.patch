+        if (!tctx_alloc_graph(&t, r0, r1)) { free(pd); free(pu); free(pi); tctx_end(&t); return; }
+        tctx_upload(&t, data, pd);
+        tctx_upload(&t, upd, pu);
+        tctx_upload(&t, idx, pi);
