+    GGML_API struct ggml_tensor * ggml_scatter_elements(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * data,
+            struct ggml_tensor  * updates,
+            struct ggml_tensor  * indices,
+            int                   reduction,
+            int                   axis);
+
     // a TD  [n_embd, ne1,    ne2,    ne3]
     // b TS  [n_embd, n_rows, ne02,   ne03] | ne02 == ne2, ne03 == ne3
     // c I64 [n_rows, ne11,   ne12,   1]    | c[i] in [0, ne1)
@@ -2104,6 +2165,37 @@ extern "C" {
             int                   p0,  // padding
             int                   d0); // dilation
 
+    // Public form of the im2col tagged with GGML_OP_IM2COL_FAST_1D (see the
+    // conv_1d_fast_1d_im2col comment below).  The explicit dst_type lets
+    // precision-sensitive callers keep an F32 im2col buffer (GGML_TYPE_F32)
+    // while still getting the 1D-specialized CPU kernel; passing
+    // GGML_TYPE_F16 reproduces the stock ggml_conv_1d memory layout.
+    // ow_align > 1 rounds the output length up to a multiple of ow_align
+    // (extra rows come from zero windows == conv zero padding, so callers can
+    // crop them with a free view); use it to keep GEMM-friendly shapes.
+    GGML_API struct ggml_tensor * ggml_im2col_fast_1d(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,   // convolution kernel [K, IC, OC]
+            struct ggml_tensor  * b,   // data [T, IC]
+            int                   s0,  // stride
+            int                   p0,  // padding
+            int                   d0,  // dilation
+            enum ggml_type        dst_type,
+            int                   ow_align);
+
+    // ggml_conv_1d variant that tags the intermediate im2col tensor with
+    // GGML_OP_IM2COL_FAST_1D so CPU schedules the 1D-specialized kernel
+    // (O(1) valid-window memcpy per row instead of the generic im2col loops).
+    // Geometry and op_params are identical to ggml_conv_1d (ported from
+    // 0xShug0/audio.cpp).
+    GGML_API struct ggml_tensor * ggml_conv_1d_fast_1d_im2col(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,   // convolution kernel
+            struct ggml_tensor  * b,   // data
+            int                   s0,  // stride
+            int                   p0,  // padding
+            int                   d0); // dilation
+
     // conv_1d with padding = half
     // alias for ggml_conv_1d(a, b, s, a->ne[0]/2, d)
     GGML_API struct ggml_tensor* ggml_conv_1d_ph(
@@ -2138,6 +2230,25 @@ extern "C" {
             int                   p0,  // padding
             int                   d0); // dilation
 
+    // extended ggml_conv_transpose_1d (ported from mmwillet/TTS.cpp's ggml fork):
+    //   op0: extra output size added at the end of the output (PyTorch
+    //        output_padding); the kernel leaves these positions at zero, a
+    //        following ggml_add can supply bias there.
+    //   g0:  grouped transposed convolution (PyTorch groups): a is
+    //        [K, Cout/g0, Cin/g0], output has a->ne[1]*g0 channels. For
+    //        g0 == 1 the layout matches plain ggml_conv_transpose_1d.
+    // Note: the 6-arg ggml_conv_transpose_1d below is kept unchanged and
+    // delegates here with op0=0, g0=1.
+    GGML_API struct ggml_tensor * ggml_conv_transpose_1d_ext(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,   // convolution kernel [K, Cout/g0, Cin/g0]
+            struct ggml_tensor  * b,   // data [L, Cin, N]
+            int                   s0,  // stride
+            int                   p0,  // padding
+            int                   d0,  // dilation (must be 1)
+            int                   op0, // output padding
+            int                   g0); // groups
+
     GGML_API struct ggml_tensor * ggml_conv_2d(
             struct ggml_context * ctx,
             struct ggml_tensor  * a,   // convolution kernel
@@ -2587,6 +2698,200 @@ extern "C" {
             struct ggml_tensor  * pw,
             struct ggml_tensor  * ph);
 
+    /* 2D Relative Position Bias (BoTNet-style, ported from ggmlR).
+     * x:    [C, H*W, B]  — query/key features (col-major)
+     * wcat: [rel_h+rel_w, C]  — concat(W_h, W_w) weight table (col-major)
+     * H, W: spatial dims; returns [H*W, H*W, B] bias matrix.
+     * out[b, q, k] = dot(x[b, q, :], wcat[:, hq-hk+H-1])
+     *              + dot(x[b, wq*H+hq, :], wcat[:, rel_h + wq-wk+W-1]) */
+    GGML_API struct ggml_tensor * ggml_rel_pos_bias(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * x,
+            struct ggml_tensor  * wcat,
+            int                   H,
+            int                   W);
+
+    // --- qvac-ops patch: Supertonic fused ConvNeXt ops (QVAC overlay) ----
+    // Ported from tetherto/qvac-ext-ghml (speech branch, MIT).
+    //
+    // Fused depthwise-conv1d + bias with edge-clamp (or causal-left)
+    // padding; collapses pad + im2col + mul_mat + bias into one dispatch.
+    // a:    [L, C]  f32 contiguous (layout=0); [C, L] for the _ct variants
+    // w:    [K, 1, C, 1]  f32 contiguous, K in {3, 5} (causal: {3,5,7})
+    // bias: [C] f32 contiguous (may be NULL)
+    // dilation: positive integer
+    GGML_API struct ggml_tensor * ggml_supertonic_depthwise_1d(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,
+            struct ggml_tensor  * w,
+            struct ggml_tensor  * bias,
+            int                   dilation);
+    GGML_API struct ggml_tensor * ggml_supertonic_depthwise_1d_ct(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,
+            struct ggml_tensor  * w,
+            struct ggml_tensor  * bias,
+            int                   dilation);
+    // [C, T]-layout + causal-left padding variant (vocoder ConvNeXt chain).
+    GGML_API struct ggml_tensor * ggml_supertonic_depthwise_1d_causal_ct(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,
+            struct ggml_tensor  * w,
+            struct ggml_tensor  * bias,
+            int                   dilation);
+
+    // Fused channel-axis layer norm + affine, single dispatch:
+    //   y[t, c] = ((a[t, c] - mean_t) / sqrt(var_t + eps)) * g[c] + b[c]
+    // a: [L, C, 1, 1] f32 contiguous; g, b: [C] f32 contiguous.
+    GGML_API struct ggml_tensor * ggml_supertonic_layer_norm_channel(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,
+            struct ggml_tensor  * g,
+            struct ggml_tensor  * b,
+            float                 eps);
+    // [C, T]-layout variant.
+    GGML_API struct ggml_tensor * ggml_supertonic_layer_norm_channel_ct(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,
+            struct ggml_tensor  * g,
+            struct ggml_tensor  * b,
+            float                 eps);
+
+    // Fused (x + bias) * gamma + residual.  bias/gamma are [C]; x and
+    // residual are [L, C, 1, 1] f32 contiguous.
+    //   y[t, c] = residual[t, c] + (x[t, c] + bias[c]) * gamma[c]
+    GGML_API struct ggml_tensor * ggml_supertonic_pw2_residual(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * x,
+            struct ggml_tensor  * bias,
+            struct ggml_tensor  * gamma,
+            struct ggml_tensor  * residual);
+    GGML_API struct ggml_tensor * ggml_supertonic_pw2_residual_ct(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * x,
+            struct ggml_tensor  * bias,
+            struct ggml_tensor  * gamma,
+            struct ggml_tensor  * residual);
+
+    // Fused bias-add + GELU (erf form); bias: [C], x: [L, C, 1, 1] f32.
+    GGML_API struct ggml_tensor * ggml_supertonic_bias_gelu(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * x,
+            struct ggml_tensor  * bias);
+    GGML_API struct ggml_tensor * ggml_supertonic_bias_gelu_ct(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * x,
+            struct ggml_tensor  * bias);
+
+    // Edge-replicate 1D padding (matches pad_left + pad_right side copies):
+    //   y[t, c] = x[clamp(t - pad_left, 0, L_in - 1), c]
+    // x: [L_in, C, 1, 1] -> [L_in + pad_left + pad_right, C, 1, 1].
+    GGML_API struct ggml_tensor * ggml_supertonic_edge_pad_1d(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * x,
+            int                   pad_left,
+            int                   pad_right);
+    GGML_API struct ggml_tensor * ggml_supertonic_edge_pad_1d_ct(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * x,
+            int                   pad_left,
+            int                   pad_right);
+
+    // --- qvac-ops patch: LavaSR denoiser ops --------------------------------
+    // Fused batched GRU, PyTorch semantics (gate order r,z,n; reset on hh
+    // new-gate; h0=0).  whh [H,3H]; gi_all [3H,B,L] = precomputed Wih*x+bih;
+    // bhh [3H] -> [H,B,L]; reverse flips t.
+    GGML_API struct ggml_tensor * ggml_gru(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * whh,
+            struct ggml_tensor  * gi_all,
+            struct ggml_tensor  * bhh,
+            bool                  reverse);
+
+    // Zero-insertion upsample of ne0 by factor s: result ne0 = (a->ne0 - 1)*s + 1,
+    // result[i0*s, ...] = a[i0, ...], zeros elsewhere.  a must be contiguous.
+    GGML_API struct ggml_tensor * ggml_zero_upsample(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,
+            int                   s);
+
+    // Channel shuffle of ne2 into `groups` groups (PyTorch): result channel c' =
+    // a channel (c'%groups)*(ne2/groups) + c'/groups. a contiguous, ne2 % groups == 0.
+    GGML_API struct ggml_tensor * ggml_channel_shuffle(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,
+            int                   groups);
+
+    // Fused affine + per-channel PReLU: out = x*aw + ab + max(x,0) + slope*min(x,0).
+    // x [F,T,C,Bc] contiguous; aw,ab [F,C] (per freq,channel); slope [C].
+    GGML_API struct ggml_tensor * ggml_affine_prelu(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * x,
+            struct ggml_tensor  * aw,
+            struct ggml_tensor  * ab,
+            struct ggml_tensor  * slope);
+
+    // --- qvac-ops patch: ACE-Step Oobleck VAE activation --------------------
+    // snake activation: y = x + sin^2(a*x) * inv_b, per-channel a / inv_b.
+    // x: [T, C] contiguous; a, inv_b: one per channel (numel == x->ne[1]).
+    GGML_API struct ggml_tensor * ggml_snake(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * x,      // [T, C]
+            struct ggml_tensor  * a,      // per-channel scale inside sin(), F32
+            struct ggml_tensor  * inv_b); // per-channel output scale, F32
+
+    // --- learned-ops patch: HiFiGAN vocoder fusion ----------------------------
+    // Fused add + leaky ReLU: out = ((v > 0) ? v : 0) + slope * ((v < 0) ? v : 0)
+    // with v = a + b, bit-identical to ggml_add followed by ggml_leaky_relu.
+    // a: [T, C] contiguous F32; b: [1, C] row-broadcast bias (per-channel
+    // scalar) or [T, C] elementwise operand (e.g. a residual), contiguous F32.
+    // CPU only (other backends fall back by not emitting the op).
+    GGML_API struct ggml_tensor * ggml_add_leaky_relu(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,      // [T, C]
+            struct ggml_tensor  * b,      // [1, C] or [T, C]
+            float                 slope);
+
+    // --- learned-ops patch: HiFiGAN direct conv --------------------------------
+    // Fused stride-1 1D convolution with in-kernel weight packing (no im2col
+    // buffer): out[t, oc] = sum_{ic,kw} w[kw, ic, oc] * x[t + kw*dil - pad, ic]
+    // + bias[oc], then leaky ReLU(slope) when slope != 0 (bit-identical to
+    // conv -> ggml_add -> ggml_leaky_relu).
+    //   w:    [K, IC, OC] F32 (standard layout, any strides ok)
+    //   x:    [T, IC] contiguous F32
+    //   bias: [OC] F32 or NULL
+    //   out:  [OL, OC] with OL = T + 2*pad - dil*(K-1)
+    // CPU only; other backends never emit the op.
+    GGML_API struct ggml_tensor * ggml_conv_direct_1d(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * w,      // [K, IC, OC]
+            struct ggml_tensor  * x,      // [T, IC]
+            struct ggml_tensor  * bias,   // [OC] or NULL
+            int                   pad,
+            int                   dil,
+            float                 leaky_slope);   // 0 = no activation
+
+    // fused variant with two extra producer-side fusions (CPU only):
+    //   res:       [OL, OC] contiguous or NULL; when set the epilogue adds it
+    //              (out = (bias + acc) + res, the same association as
+    //              ggml_add(conv_out, res)) replacing a separate ADD node.
+    //   in_scale:  multiply x while packing the padded copy (replaces
+    //              ggml_scale; 1.0f = off).  Applied first, i.e. pad(x*s).
+    //   in_slope:  leaky-ReLU applied to x while packing (replaces a preceding
+    //              ggml_leaky_relu; 0.0f = off).  Applied after in_scale:
+    //              pad(leaky(x * s)) == leaky(ggml_scale(x, s)) bit-identically.
+    GGML_API struct ggml_tensor * ggml_conv_direct_1d_fused(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * w,      // [K, IC, OC]
+            struct ggml_tensor  * x,      // [T, IC]
+            struct ggml_tensor  * bias,   // [OC] or NULL
+            struct ggml_tensor  * res,    // [OL, OC] or NULL
+            int                   pad,
+            int                   dil,
+            float                 leaky_slope,   // 0 = no output activation
+            float                 in_scale,      // 1 = no input scaling
+            float                 in_slope);     // 0 = no input activation
+
     GGML_API struct ggml_tensor * ggml_rwkv_wkv6(
             struct ggml_context * ctx,
             struct ggml_tensor  * k,
