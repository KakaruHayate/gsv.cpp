diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/gru.comp b/ggml/src/ggml-vulkan/vulkan-shaders/gru.comp
new file mode 100644
index 0000000..1bba77d
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/gru.comp
@@ -0,0 +1,77 @@
+#version 450
+
+#include "types.glsl"
+
+// Fused batched GRU (PyTorch: gate order r,z,n, reset on hh new-gate, h0=0).
+// whh [H,3H], gi [3H,B,L], bhh [3H] -> dst [H,B,L]; 128-lane WG packs 128/H batch elems.
+#define GRU_MAX_H 128
+
+layout (push_constant) uniform parameter
+{
+    uint H;
+    uint B;
+    uint L;
+    uint reverse;
+} p;
+
+layout (binding = 0) readonly buffer W {float data_whh[];};
+layout (binding = 1) readonly buffer G {float data_gi[];};
+layout (binding = 2) readonly buffer BH {float data_bhh[];};
+layout (binding = 3) writeonly buffer D {float data_d[];};
+
+layout(local_size_x = GRU_MAX_H, local_size_y = 1, local_size_z = 1) in;
+
+shared float h_l[GRU_MAX_H];        // flat, slot-major: h_l[b_local*H + j] == h_l[lane]
+shared float gh_l[3 * GRU_MAX_H];   // flat: gh_l[b_local*3H + g]
+
+void main() {
+    const uint lane    = gl_LocalInvocationID.x;
+    const uint PB      = GRU_MAX_H / p.H;                   // batch elems per WG (uniform)
+    const uint b_local = lane / p.H;                        // slot in this WG
+    const uint j       = lane - b_local * p.H;              // hidden unit
+    const uint b       = gl_WorkGroupID.y * PB + b_local;   // global batch element
+    const uint H3      = 3u * p.H;
+    const uint hbase   = b_local * p.H;                     // == lane - j
+    const uint gbase   = b_local * H3;
+
+    // Ragged (128 % H != 0) and batch-tail lanes idle but run every barrier.
+    const bool lane_live = (b_local < PB) && (b < p.B);
+
+    if (lane_live) {
+        h_l[lane] = 0.0f;                                   // zero initial state
+    }
+    barrier();
+
+    // barrier()s stay in uniform control flow: every lane runs all L steps.
+    for (uint s = 0u; s < p.L; ++s) {
+        const uint t       = (p.reverse != 0u) ? (p.L - 1u - s) : s;
+        const uint gi_base = H3 * b + H3 * p.B * t;
+
+        // pass 1: gh[g] = sum_k whh[k,g]*h[k] + bhh[g] for this lane's 3 gate rows
+        // (CPU reference order: bias added after the accumulation).
+        if (lane_live) {
+            for (uint gg = 0u; gg < 3u; ++gg) {
+                const uint g     = gg * p.H + j;
+                const uint wbase = p.H * g;
+                float acc = 0.0f;
+                for (uint k = 0u; k < p.H; ++k) {
+                    acc += data_whh[wbase + k] * h_l[hbase + k];
+                }
+                gh_l[gbase + g] = acc + data_bhh[g];
+            }
+        }
+        barrier();
+
+        // pass 2: gates + state update (each lane touches only h_l[lane]).
+        // exp/tanh args saturated: some mobile drivers NaN on exp overflow (>~88.7) not +inf; clamps bit-equal in fp32.
+        if (lane_live) {
+            const float r  = 1.0f / (1.0f + exp(min(-(data_gi[gi_base + j] + gh_l[gbase + j]), 88.0f)));
+            const float z  = 1.0f / (1.0f + exp(min(-(data_gi[gi_base + p.H + j] + gh_l[gbase + p.H + j]), 88.0f)));
+            const float nc = tanh(clamp(data_gi[gi_base + 2u * p.H + j] + r * gh_l[gbase + 2u * p.H + j], -15.0f, 15.0f));
+            const float hn = nc + z * (h_l[lane] - nc);
+            data_d[p.H * b + p.H * p.B * t + j] = hn;
+            h_l[lane] = hn;
+        }
+        barrier();
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/gru_small.comp b/ggml/src/ggml-vulkan/vulkan-shaders/gru_small.comp
new file mode 100644
index 0000000..1d90032
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/gru_small.comp
@@ -0,0 +1,77 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+
+#include "types.glsl"
+
+// Small-H fused GRU compiled per exact H (H_C; host selects p.H == H_C); fp op order matches
+// CPU reference / gru.comp exactly. whh [H,3H], gi [3H,B,L], bhh [3H] -> dst [H,B,L].
+#define WG_SIZE 128
+
+layout (push_constant) uniform parameter
+{
+    uint H;
+    uint B;
+    uint L;
+    uint reverse;
+} p;
+
+layout (binding = 0) readonly buffer W {float data_whh[];};
+layout (binding = 1) readonly buffer G {float data_gi[];};
+layout (binding = 2) readonly buffer BH {float data_bhh[];};
+layout (binding = 3) writeonly buffer D {float data_d[];};
+
+layout(local_size_x = WG_SIZE, local_size_y = 1, local_size_z = 1) in;
+
+shared float w_sh[H_C * 3 * H_C];   // whh, k-major per gate row
+shared float b_sh[3 * H_C];         // bhh
+
+void main() {
+    const uint lane = gl_LocalInvocationID.x;
+    const uint b    = gl_WorkGroupID.y * WG_SIZE + lane;    // global batch element
+    const uint H3   = 3u * H_C;
+
+    for (uint i = lane; i < H_C * H3; i += WG_SIZE) {
+        w_sh[i] = data_whh[i];
+    }
+    if (lane < H3) {
+        b_sh[lane] = data_bhh[lane];
+    }
+    barrier();
+
+    if (b >= p.B) {
+        return;                                             // after the only barrier
+    }
+
+    float h[H_C];
+    float gh[3 * H_C];
+    [[unroll]] for (uint j = 0u; j < H_C; ++j) {
+        h[j] = 0.0f;                                        // zero initial state
+    }
+
+    for (uint s = 0u; s < p.L; ++s) {
+        const uint t       = (p.reverse != 0u) ? (p.L - 1u - s) : s;
+        const uint gi_base = H3 * b + H3 * p.B * t;
+
+        // gh[g] = sum_k whh[k,g]*h[k] + bhh[g] (bias after accumulation, CPU order).
+        [[unroll]] for (uint g = 0u; g < 3u * H_C; ++g) {
+            float acc = 0.0f;
+            [[unroll]] for (uint k = 0u; k < H_C; ++k) {
+                acc += w_sh[H_C * g + k] * h[k];
+            }
+            gh[g] = acc + b_sh[g];
+        }
+
+        // gates + state update; exp/tanh args saturated (mobile drivers NaN on
+        // exp overflow instead of +inf); clamps bit-equivalent in fp32.
+        const uint obase = H_C * b + H_C * p.B * t;
+        [[unroll]] for (uint j = 0u; j < H_C; ++j) {
+            const float r  = 1.0f / (1.0f + exp(min(-(data_gi[gi_base + j] + gh[j]), 88.0f)));
+            const float z  = 1.0f / (1.0f + exp(min(-(data_gi[gi_base + H_C + j] + gh[H_C + j]), 88.0f)));
+            const float nc = tanh(clamp(data_gi[gi_base + 2u * H_C + j] + r * gh[2u * H_C + j], -15.0f, 15.0f));
+            const float hn = nc + z * (h[j] - nc);
+            data_d[obase + j] = hn;
+            h[j] = hn;
+        }
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/rel_pos_bias.comp b/ggml/src/ggml-vulkan/vulkan-shaders/rel_pos_bias.comp
new file mode 100644
index 0000000..90d50d2
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/rel_pos_bias.comp
@@ -0,0 +1,63 @@
+#version 450
+
+#extension GL_EXT_shader_16bit_storage : require
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;
+
+/* push_constants: H, W, B (heads/batch), C, rel_h (=2*H-1) */
+layout(push_constant) uniform Params {
+    uint H;
+    uint W;
+    uint B;
+    uint C;
+    uint rel_h;   /* 2*H-1 */
+    uint rel_w;   /* 2*W-1; rel_h + rel_w = W-stride of weight table */
+} p;
+
+/* src0 = x:    [C, H*W, B]  (ggml col-major = ONNX [B, H*W, C]) */
+layout(binding = 0) readonly buffer SrcX { float data_x[]; };
+
+/* src1 = wcat: [rel_h+rel_w, C]  (col-major = ONNX [C, rel_h+rel_w]) */
+layout(binding = 1) readonly buffer SrcW { float data_w[]; };
+
+/* dst:         [H*W, H*W, B]  (col-major = ONNX [B, H*W, H*W]) */
+layout(binding = 2) writeonly buffer Dst { float data_dst[]; };
+
+void main() {
+    /* Each thread computes one output element: (wk, hk, b) dispatched over
+     * (wq*hq) outer loop. Dispatch: x=wk, y=hk, z=b*HW+q_idx */
+    const uint wk   = gl_GlobalInvocationID.x;
+    const uint hk   = gl_GlobalInvocationID.y;
+    const uint bq   = gl_GlobalInvocationID.z;  /* b * HW + q_idx */
+
+    const uint HW     = p.H * p.W;
+    const uint Wstride = p.rel_h + p.rel_w;
+
+    if (wk >= p.W || hk >= p.H || bq >= p.B * HW) return;
+
+    const uint b     = bq / HW;
+    const uint q_idx = bq % HW;
+    const uint hq    = q_idx / p.W;
+    const uint wq    = q_idx % p.W;
+
+    /* x[b, hq*W+wq, c]  for H-axis dot  — ggml offset: c + q_idx*C + b*C*HW */
+    /* x[b, wq*H+hq, c]  for W-axis dot  — ggml offset: c + (wq*H+hq)*C + b*C*HW */
+    const uint x_base_hw = b * p.C * HW + q_idx * p.C;
+    const uint x_base_wh = b * p.C * HW + (wq * p.H + hq) * p.C;
+
+    const uint r_h = hq - hk + p.H - 1;   /* relative height index */
+    const uint r_w = wq - wk + p.W - 1;   /* relative width  index */
+
+    /* dot(x_hw, W_h[:, r_h]):  W_h is first rel_h columns of wcat
+     * wcat layout: w[c * Wstride + r] */
+    float dot_h = 0.0;
+    float dot_w = 0.0;
+    for (uint ci = 0; ci < p.C; ci++) {
+        dot_h += data_x[x_base_hw + ci] * data_w[ci * Wstride + r_h];
+        dot_w += data_x[x_base_wh + ci] * data_w[ci * Wstride + p.rel_h + r_w];
+    }
+
+    const uint k_idx = hk * p.W + wk;
+    /* dst ggml [HW, HW, B]: dst[k_idx + q_idx*HW + b*HW*HW] */
+    data_dst[k_idx + q_idx * HW + b * HW * HW] = dot_h + dot_w;
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/scatter_elements.comp b/ggml/src/ggml-vulkan/vulkan-shaders/scatter_elements.comp
new file mode 100644
index 0000000..1f96a15
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/scatter_elements.comp
@@ -0,0 +1,67 @@
+#version 450
+
+#ifdef SCATTER_ADD
+#extension GL_EXT_shader_atomic_float : enable
+#endif
+
+#include "types.glsl"
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (push_constant) uniform parameter
+{
+    uint ne;
+    uint ne00; uint ne01; uint ne02; uint ne03; uint nb00; uint nb01; uint nb02; uint nb03;
+    uint ne10; uint ne11; uint ne12; uint ne13; uint nb10; uint nb11; uint nb12; uint nb13;
+    uint ne20; uint ne21; uint ne22; uint ne23; uint nb20; uint nb21; uint nb22; uint nb23;
+    uint misalign_offsets;
+    float param1; float param2; int param3;
+} p;
+
+layout (binding = 0) readonly  buffer A { float data_a[]; };  // updates (src0)
+layout (binding = 1) readonly  buffer B { int   data_b[]; };  // indices (src1)
+layout (binding = 2)           buffer D { float data_d[]; };  // output (pre-filled with data)
+
+uint get_aoffset() { return p.misalign_offsets >> 16; }
+uint get_boffset() { return (p.misalign_offsets >> 8) & 0xFF; }
+uint get_doffset() { return p.misalign_offsets & 0xFF; }
+
+void main() {
+    const uint gid = gl_GlobalInvocationID.x;
+
+    /* Total elements in updates = ne00 * ne01 * ne02 * ne03 */
+    const uint total = p.ne00 * p.ne01 * p.ne02 * p.ne03;
+    if (gid >= total) return;
+
+    /* axis is stored in param3 (ggml dim order) */
+    const int axis = p.param3;
+
+    /* Decompose flat index into 4D multi-index for updates */
+    uint rem = gid;
+    uint mi3 = rem / (p.ne00 * p.ne01 * p.ne02);
+    rem -= mi3 * (p.ne00 * p.ne01 * p.ne02);
+    uint mi2 = rem / (p.ne00 * p.ne01);
+    rem -= mi2 * (p.ne00 * p.ne01);
+    uint mi1 = rem / p.ne00;
+    uint mi0 = rem - mi1 * p.ne00;
+
+    /* Read scatter index */
+    const int scatter_idx = data_b[get_boffset() + gid];
+
+    /* Build dst multi-index: same as updates, except along axis */
+    uint di0 = mi0, di1 = mi1, di2 = mi2, di3 = mi3;
+    if      (axis == 0) di0 = uint(scatter_idx);
+    else if (axis == 1) di1 = uint(scatter_idx);
+    else if (axis == 2) di2 = uint(scatter_idx);
+    else                di3 = uint(scatter_idx);
+
+    /* dst strides (contiguous): ne20=dst.ne[0], ne21=dst.ne[1], etc. */
+    const uint dst_off = get_doffset() + di0 + di1 * p.ne20 + di2 * p.ne20 * p.ne21 + di3 * p.ne20 * p.ne21 * p.ne22;
+    const float val = data_a[get_aoffset() + gid];
+
+#ifdef SCATTER_ADD
+    atomicAdd(data_d[dst_off], val);
+#else
+    data_d[dst_off] = val;
+#endif
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
