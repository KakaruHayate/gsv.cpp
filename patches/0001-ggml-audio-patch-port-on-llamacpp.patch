+// ggml_im2col_fast_1d (ported from 0xShug0/audio.cpp)
+//
+// Same geometry and op_params as ggml_im2col (1D, is_2D == false), but tagged
+// with GGML_OP_IM2COL_FAST_1D so backends can pick the 1D-specialized kernel.
+// The CPU specialization reduces each output row to an O(1) valid input
+// window with head/tail zero-fill and memcpy when dilation == 1.
+
+static struct ggml_tensor * ggml_im2col_fast_1d_impl(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        int                   s0,
+        int                   s1,
+        int                   p0,
+        int                   p1,
+        int                   d0,
+        int                   d1,
+        bool                  is_2D,
+        enum ggml_type        dst_type) {
+    struct ggml_tensor * result = ggml_im2col(ctx, a, b, s0, s1, p0, p1, d0, d1, is_2D, dst_type);
+    result->op = GGML_OP_IM2COL_FAST_1D;
+    return result;
+}
+
+// Public 1D form (stride/padding/dilation + explicit dst_type).  Keeps an F32
+// im2col buffer available for precision-sensitive paths.
+// ow_align > 1 rounds the output length UP to a multiple of ow_align: rows in
+// [OW, align_up(OW)) are computed from partially out-of-range windows (the
+// kernel zero-fills), which is numerically identical to conv zero padding for
+// the valid rows, so the caller can crop them with a free view.  This exists
+// so GEMM-friendly lengths (e.g. multiples of 16 for the CPU tinyBLAS tiling)
+// can be enforced without touching the input tensor.
+struct ggml_tensor * ggml_im2col_fast_1d(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        int                   s0,
+        int                   p0,
+        int                   d0,
+        enum ggml_type        dst_type,
+        int                   ow_align) {
+    GGML_ASSERT(b->ne[1] == a->ne[1]);
+    GGML_ASSERT(b->ne[3] == 1);
+    GGML_ASSERT(ow_align >= 1);
+
+    const int64_t OW = ggml_calc_conv_output_size(b->ne[0], a->ne[0], s0, p0, d0);
+    int64_t OWp = OW;
+    if (ow_align > 1) {
+        OWp = (OW + ow_align - 1) / ow_align * ow_align;
+    }
+    GGML_ASSERT(OW > 0 && "b too small compared to a");
+
+    const int64_t ne[4] = { a->ne[1] * a->ne[0], OWp, b->ne[2], 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, dst_type, 4, ne);
+    int32_t params[] = { s0, 0, p0, 0, d0, 0, 0 };
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_IM2COL_FAST_1D;
+    result->src[0] = a;
+    result->src[1] = b;
+    return result;
+}
+
+struct ggml_tensor * ggml_conv_1d_fast_1d_im2col(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        int                   s0,
+        int                   p0,
+        int                   d0) {
+    struct ggml_tensor * im2col = ggml_im2col_fast_1d_impl(ctx, a, b, s0, 0, p0, 0, d0, 0, false, a->type == GGML_TYPE_BF16 ? GGML_TYPE_F32 : GGML_TYPE_F16); // [N, OL, IC * K]
+
+    struct ggml_tensor * result =
+        ggml_mul_mat(ctx,
+                ggml_reshape_2d(ctx, im2col, im2col->ne[0], (im2col->ne[2] * im2col->ne[1])), // [N, OL, IC * K] => [N*OL, IC * K]
+                ggml_reshape_2d(ctx, a, (a->ne[0] * a->ne[1]), a->ne[2]));                    // [OC，IC, K] => [OC, IC * K]
+
+    result = ggml_reshape_3d(ctx, result, im2col->ne[1], a->ne[2], im2col->ne[2]); // [N, OC, OL]
+
+    return result;
+}
