+    struct ggml_tensor * result = ggml_new_tensor_4d(ctx, a->type,
+            a->ne[0], a->ne[1], a->ne[2], a->ne[3]);
+
+    float params[2];
+    memcpy(&params[0], &eps, sizeof(float));
+    ((int32_t *) &params[1])[0] = layout;
+    ggml_set_op_params(result, params, sizeof(params));
