+    vk_op_snake_push_constants pc{};
+    pc.ne0 = static_cast<uint32_t>(src0->ne[0]);
+    pc.ne1 = static_cast<uint32_t>(src0->ne[1]);
+
+    ggml_vk_op_f32<vk_op_snake_push_constants>(ctx, subctx, src0, src1, src2, nullptr, dst, GGML_OP_SNAKE, std::move(pc));
+}
