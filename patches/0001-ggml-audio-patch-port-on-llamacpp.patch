+    const int32_t * op_params = (const int32_t *)dst->op_params;
+    float slope, in_scale, in_slope;
+    memcpy(&slope,    &op_params[2], sizeof(float));
+    memcpy(&in_scale, &op_params[4], sizeof(float));
+    memcpy(&in_slope, &op_params[5], sizeof(float));
