+    // learned-ops patch (from ggmlR)
+    string_to_spv("rel_pos_bias_f32", "rel_pos_bias.comp", {});
+    string_to_spv("scatter_elements_none", "scatter_elements.comp", {});
+    string_to_spv("scatter_elements_add", "scatter_elements.comp", {{"SCATTER_ADD", "1"}});
+
+    // qvac-ops patch (ported from tetherto/qvac-ext-ggml, MIT)
+    // (snake reuses the upstream snake_f32 pipeline)
+    string_to_spv("gru_f32",             "gru.comp",             {{"A_TYPE", "float"}});
+    string_to_spv("gru_small_h2_f32",    "gru_small.comp",       {{"A_TYPE", "float"}, {"H_C", "2"}});
+    string_to_spv("gru_small_h4_f32",    "gru_small.comp",       {{"A_TYPE", "float"}, {"H_C", "4"}});
+    string_to_spv("gru_small_h8_f32",    "gru_small.comp",       {{"A_TYPE", "float"}, {"H_C", "8"}});
+    string_to_spv("zero_upsample_f32",   "zero_upsample.comp",   {{"A_TYPE", "float"}, {"D_TYPE", "float"}});
+    string_to_spv("channel_shuffle_f32", "channel_shuffle.comp", {{"A_TYPE", "float"}, {"D_TYPE", "float"}});
+    string_to_spv("affine_prelu_f32",    "affine_prelu.comp",    {{"A_TYPE", "float"}});
+
+    // direct 1-D convolution (F32 implicit GEMM).  A = w viewed as
+    // [OC, IC*K] (contiguous k), B = x [t, k] — coalesced on both sides.
+    // Tile parameters are Vulkan spec constants (mul_mm style): one SPIR-V,
+    // the warptile is chosen per pipeline at creation time.
+    string_to_spv("conv_direct_1d_f32", "conv_direct_1d.comp", {});
+
     string_to_spv("col2im_1d_f32",  "col2im_1d.comp", {{"DATA_A_F32", "1"},  {"A_TYPE", "float"},     {"D_TYPE", "float"}});
     string_to_spv("col2im_1d_f16",  "col2im_1d.comp", {{"DATA_A_F16", "1"},  {"A_TYPE", "float16_t"}, {"D_TYPE", "float16_t"}});
     string_to_spv("col2im_1d_bf16", "col2im_1d.comp", {{"DATA_A_BF16", "1"}, {"A_TYPE", "uint16_t"},  {"D_TYPE", "uint16_t"}});
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/zero_upsample.comp b/ggml/src/ggml-vulkan/vulkan-shaders/zero_upsample.comp
new file mode 100644
index 0000000..925ebe0
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/zero_upsample.comp
@@ -0,0 +1,30 @@
+#version 450
+
+#include "types.glsl"
+
+// Zero-insertion upsample of ne0 by s (LavaSR denoiser transpose-conv):
+// dst[f] = (f % s == 0) ? src[f / s] : 0.  One thread per dst element (gather form).
+layout (push_constant) uniform parameter
+{
+    uint ne;   // total dst elements
+    uint F;    // src ne0
+    uint Fu;   // dst ne0 = (F-1)*s+1
+    uint s;    // upsample stride
+} p;
+
+layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
+layout (binding = 1) writeonly buffer D {D_TYPE data_d[];};
+
+layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;
+    if (idx >= p.ne) {
+        return;
+    }
+
+    const uint r = idx / p.Fu;
+    const uint f = idx - r * p.Fu;
+
+    data_d[idx] = (f % p.s == 0u) ? D_TYPE(data_a[r * p.F + f / p.s]) : D_TYPE(0.0f);
+}
diff --git a/ggml/src/ggml.c b/ggml/src/ggml.c
index 9bcabdb..5536bca 100644
