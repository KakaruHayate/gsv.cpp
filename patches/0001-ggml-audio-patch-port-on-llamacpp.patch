+static void ggml_vk_rel_pos_bias(ggml_backend_vk_context * ctx, vk_context& subctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    GGML_ASSERT(src0->type == GGML_TYPE_F32);
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT( dst->type == GGML_TYPE_F32);
+
+    const int32_t H     = ((const int32_t *)dst->op_params)[0];
+    const int32_t W     = ((const int32_t *)dst->op_params)[1];
+    const int32_t B     = ((const int32_t *)dst->op_params)[2];
+    const int32_t C     = ((const int32_t *)dst->op_params)[3];
+    const int32_t rel_h = ((const int32_t *)dst->op_params)[4];
+    const int32_t rel_w = 2*W - 1;
+
+    vk_op_rel_pos_bias_push_constants pc{
+        static_cast<uint32_t>(H),
+        static_cast<uint32_t>(W),
+        static_cast<uint32_t>(B),
+        static_cast<uint32_t>(C),
+        static_cast<uint32_t>(rel_h),
+        static_cast<uint32_t>(rel_w),
+    };
+
+    ggml_vk_op_f32<vk_op_rel_pos_bias_push_constants>(ctx, subctx, src0, src1, nullptr, nullptr, dst, GGML_OP_REL_POS_BIAS, std::move(pc));
+}
